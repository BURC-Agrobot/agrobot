# syntax=docker/dockerfile:1.7
# CV runtime for the EVO-X2 Radeon 8060S using AMD ROCm
# Use the archived AMD base with Ubuntu 24.04 and ROS 2 Jazzy
#
# Build from the repository root
#   docker build \
#     --file deployment/docker/Dockerfile.cv-evox2-amd-rocm \
#     --tag agrobot-cv:evox2-amd-rocm \
#     .

# Pin the verified Linux AMD64 image so the base stays reproducible
FROM rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1@sha256:96a2fb24dec9896e2f8238178f0c49d0dcc4c7dcc597be09e4564316bd86d191 AS base

ENV DEBIAN_FRONTEND=noninteractive

# ── ROS 2 Jazzy ───────────────────────────────────────────────────────────────
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-vision-msgs \
    ros-jazzy-sensor-msgs-py \
    ros-jazzy-realsense2-camera \
    python3-colcon-common-extensions \
    git tmux htop vim \
    && rm -rf /var/lib/apt/lists/*

# ── Perception Python deps ────────────────────────────────────────────────────
# CRITICAL: the rocm/pytorch base image keeps its Python (and the verified-good
# torch 2.9.1+rocm7.2.1) in a venv at /opt/venv — NOT system Python. Perception
# deps MUST install into that same venv or the nodes cannot import torch.
# (Verified 2026-05-22: the earlier `pip3 --break-system-packages` installed to
# system Python and every perception node failed with ModuleNotFoundError.)
#
# Pin NumPy 1.x and compatible Python packages in one dependency list
COPY deployment/docker/requirements.txt /opt/agrobot/requirements.txt

# Prepare pinned build tools before building the source-only packages
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps \
    --constraint /opt/agrobot/requirements.txt setuptools wheel

# Preserve AMD torch packages by installing only the explicit dependency list
# Reuse the base environment so source builds do not fetch another torch
# Omit SAM2's optional CUDA extension, absent in the archived evaluation
RUN SAM2_BUILD_CUDA=0 /opt/venv/bin/python -m pip install \
    --no-cache-dir --no-deps --no-build-isolation \
    --requirement /opt/agrobot/requirements.txt && \
    /opt/venv/bin/python -m pip check

# ── Environment ───────────────────────────────────────────────────────────────
WORKDIR /workspace
RUN mkdir -p /ros2_ws/src

ENV ROS_DOMAIN_ID=0
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ENV PATH=/opt/venv/bin:/opt/rocm/bin:${PATH}

# Make venv packages (torch, scipy, sam2, transformers, etc.) visible to the
# system Python used by colcon entry point scripts (shebang #!/usr/bin/python3).
# source /opt/ros/jazzy/setup.bash prepends its own site-packages, so ROS
# packages take priority — this does not conflict with ros2 package resolution.
ENV PYTHONPATH=/opt/venv/lib/python3.12/site-packages

# HSA_OVERRIDE_GFX_VERSION: safety fallback — ROCm 7.2.1 auto-detects gfx1151
# on kernel 6.17.0-1023-oem, but this guards against ISA misdetection if the
# kernel or driver ever changes. Do NOT use 11.0.x — those target gfx1100
# (discrete RDNA 3) and SIGBUS on gfx1151's unified memory controller.
ENV HSA_OVERRIDE_GFX_VERSION=11.5.1

# GPU_MAX_HW_QUEUES: 8 CU clusters on Strix Halo — maximises parallelism for
# concurrent DINOv2 + SAM2 inference streams.
ENV GPU_MAX_HW_QUEUES=8

# HSA_ENABLE_SDMA=0: SDMA overhead is higher than CPU memcpy on unified memory
# (no discrete VRAM). Forces ROCm to use CPU-side blit copies instead.
ENV HSA_ENABLE_SDMA=0

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

# Install the required startup script and fail if it cannot be made executable
COPY deployment/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
