# syntax=docker/dockerfile:1.7
# CV runtime for the EVO-X2 Radeon 8060S using AMD ROCm
# Use the archived AMD base with Ubuntu 24.04 and ROS 2 Jazzy
#
# Build from the repository root
#   docker build \
#     --file deployment/docker/Dockerfile.cv-evox2-amd-rocm \
#     --tag agrobot-cv:evox2-amd-rocm \
#     .

# Pin the verified Linux AMD64 image so the base stays reproducible
FROM rocm/pytorch:rocm7.2.1_ubuntu24.04_py3.12_pytorch_release_2.9.1@sha256:96a2fb24dec9896e2f8238178f0c49d0dcc4c7dcc597be09e4564316bd86d191 AS base

ENV DEBIAN_FRONTEND=noninteractive

# ROS 2 Jazzy
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-vision-msgs \
    ros-jazzy-sensor-msgs-py \
    ros-jazzy-realsense2-camera \
    python3-colcon-common-extensions \
    git tmux htop vim \
    && rm -rf /var/lib/apt/lists/*

# Perception Python deps
# CRITICAL: rocm/pytorch uses a virtual environment at /opt/venv
# It contains Python and the verified torch 2.9.1+rocm7.2.1
# Install perception dependencies in this environment, not in system Python
# Otherwise, the nodes cannot import torch
# Checks on 2026-05-22 found that pip3 --break-system-packages used system Python
# Every perception node then failed with ModuleNotFoundError
#
# Pin NumPy 1.x and compatible Python packages in one dependency list
COPY deployment/docker/requirements.txt /opt/agrobot/requirements.txt

# Prepare pinned build tools before building the source-only packages
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps \
    --constraint /opt/agrobot/requirements.txt setuptools wheel

# Preserve AMD torch packages by installing only the explicit dependency list
# Reuse the base environment so source builds do not fetch another torch
# Omit SAM2's optional CUDA extension, absent in the archived evaluation
RUN SAM2_BUILD_CUDA=0 /opt/venv/bin/python -m pip install \
    --no-cache-dir --no-deps --no-build-isolation \
    --requirement /opt/agrobot/requirements.txt && \
    /opt/venv/bin/python -m pip check

# Environment
WORKDIR /workspace
RUN mkdir -p /ros2_ws/src

ENV ROS_DOMAIN_ID=0
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ENV PATH=/opt/venv/bin:/opt/rocm/bin:${PATH}

# Expose virtual-environment packages to the system Python that colcon uses
# These packages include torch, scipy, sam2, and transformers
# The colcon entry scripts use the shebang #!/usr/bin/python3
# source /opt/ros/jazzy/setup.bash places its site-packages first
# ROS packages take priority without conflicting with ros2 package resolution
ENV PYTHONPATH=/opt/venv/lib/python3.12/site-packages

# HSA_OVERRIDE_GFX_VERSION protects against incorrect ISA detection
# ROCm 7.2.1 detects gfx1151 automatically on kernel 6.17.0-1023-oem
# This override protects against detection errors after kernel or driver changes
# Do NOT use 11.0.x, which targets gfx1100 (discrete RDNA 3)
# Those versions cause SIGBUS on the gfx1151 unified memory controller
ENV HSA_OVERRIDE_GFX_VERSION=11.5.1

# Strix Halo has 8 CU clusters
# GPU_MAX_HW_QUEUES maximizes parallel DINOv2 and SAM2 inference
ENV GPU_MAX_HW_QUEUES=8

# SDMA overhead exceeds CPU memcpy overhead on unified memory without VRAM
# HSA_ENABLE_SDMA=0 forces ROCm to copy data through CPU blit operations
ENV HSA_ENABLE_SDMA=0

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

# Install the required startup script and fail if it cannot be made executable
COPY deployment/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
