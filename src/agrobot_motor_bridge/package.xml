<?xml version="1.0"?>
<package format="3">
  <!-- Identify the package and its ownership for ROS discovery -->
  <name>agrobot_motor_bridge</name>
  <version>0.1.0</version>
  <description>Custom SocketCAN CANopen driver for Agrobot EPOS2 drives.</description>
  <maintainer email="gsylvia@bu.edu">Garrett Sylvia</maintainer>
  <license>BSD-3-Clause</license>
  <!-- Declare the build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Declare the analysis tool required by test-enabled builds -->
  <test_depend>clang-tidy</test_depend>
  <!-- Select the build system used by colcon -->
  <export><build_type>ament_cmake</build_type></export>
</package>
