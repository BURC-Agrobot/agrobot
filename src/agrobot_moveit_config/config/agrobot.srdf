<?xml version="1.0" encoding="UTF-8"?>
<!--This format describes the meaning of the robot structure.
    It does not replace or extend URDF.
    The robot must also have a URDF file that defines the referenced joints and links
-->
<robot name="agrobot">
    <!--GROUPS: Define sets of joints and links. Groups can specify degrees of freedom (DOF) for planning, arms, or end effectors-->
    <!--LINKS: A specified link automatically includes its parent joint, if that joint exists-->
    <!--JOINTS: A specified joint automatically includes its child link. The child link always exists-->
    <!--CHAINS: A specified chain includes all its links, including both endpoints, in the group.
    The group also includes every parent joint of those links.
    These joints include the joints along the chain and the parent joint of the base link-->
    <!--SUBGROUPS: A group can reference the names of existing groups-->
    <group name="arm">
        <chain base_link="base_link" tip_link="arm_link_6"/>
    </group>
    <group name="rail">
        <joint name="rail_joint"/>
    </group>
    <!--GROUP STATES: Define a named state for a group through joint values, such as 'folded arms'-->
    <group_state name="start" group="rail">
        <joint name="rail_joint" value="0"/>
    </group_state>
    <group_state name="ready" group="arm">
        <joint name="arm_joint_1" value="0"/>
        <joint name="arm_joint_2" value="0"/>
        <joint name="arm_joint_3" value="0"/>
        <joint name="arm_joint_4" value="0"/>
        <joint name="arm_joint_5" value="0"/>
        <joint name="arm_joint_6" value="0"/>
    </group_state>
    <!--DISABLE COLLISIONS: By default, assume that any robot link could collide with any other robot link.
    This tag disables collision checks between the specified pair of links -->
    <disable_collisions link1="arm_link_1" link2="arm_link_2" reason="Adjacent"/>
    <disable_collisions link1="arm_link_1" link2="arm_link_3" reason="Never"/>
    <disable_collisions link1="arm_link_1" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="arm_link_1" link2="rail_link" reason="Default"/>
    <disable_collisions link1="arm_link_2" link2="arm_link_3" reason="Adjacent"/>
    <disable_collisions link1="arm_link_2" link2="arm_link_4" reason="Never"/>
    <disable_collisions link1="arm_link_2" link2="base_link" reason="Never"/>
    <disable_collisions link1="arm_link_2" link2="rail_link" reason="Never"/>
    <disable_collisions link1="arm_link_3" link2="arm_link_4" reason="Adjacent"/>
    <disable_collisions link1="arm_link_3" link2="arm_link_5" reason="Never"/>
    <disable_collisions link1="arm_link_3" link2="arm_link_6" reason="Never"/>
    <disable_collisions link1="arm_link_3" link2="base_link" reason="Never"/>
    <disable_collisions link1="arm_link_3" link2="rail_link" reason="Never"/>
    <disable_collisions link1="arm_link_4" link2="arm_link_5" reason="Adjacent"/>
    <disable_collisions link1="arm_link_5" link2="arm_link_6" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rail_link" reason="Adjacent"/>
</robot>
